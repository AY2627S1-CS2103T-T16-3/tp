@startuml
!include style.puml
skinparam dpi 150
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
participant "employees:\nUniqueEmployeeList" as Employees MODEL_COLOR
participant "leaves:\nUniqueLeaveList" as Leaves MODEL_COLOR
end box

[-> ModelManager : deleteEmployee(e)
activate ModelManager
ModelManager -> AddressBook : removeEmployee(e)
activate AddressBook
AddressBook -> Employees : remove(e)
activate Employees
Employees --> AddressBook
deactivate Employees
AddressBook -> Leaves : removeAllFor(id)
activate Leaves
Leaves --> AddressBook
deactivate Leaves
AddressBook --> ModelManager
deactivate AddressBook
[<-- ModelManager
deactivate ModelManager
@enduml
